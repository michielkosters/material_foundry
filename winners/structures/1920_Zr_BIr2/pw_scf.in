&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
/
&SYSTEM
  ibrav = 0,
  nat = 5,
  ntyp = 3,
  ecutwfc = 40.0,
  ecutrho = 320.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.020,
/
&ELECTRONS
  conv_thr = 1.0d-5,
  mixing_beta = 0.35,
  electron_maxstep = 150,
/
ATOMIC_SPECIES
  B       10.8100  b_pbe_v1.4.uspp.F.UPF
  Ir     192.2170  Ir_pbe_v1.2.uspp.F.UPF
  Zr      91.2240  Zr_pbe_v1.uspp.F.UPF
CELL_PARAMETERS {angstrom}
     -3.8073091951      0.0000000000      0.0000000000
     -0.0000000000     -3.8073091951      0.0000000000
      1.9036545975      1.9036545975      4.3807496445
ATOMIC_POSITIONS {crystal}
  Zr       0.0000000000      0.0000000000      0.0000000000
  B        0.3968960892      0.3968960892      0.7937921784
  B        0.6031039108      0.6031039108      0.2062078216
  Ir       0.2500000000      0.7500000000      0.5000000000
  Ir       0.7500000000      0.2500000000      0.5000000000
K_POINTS {automatic}
  6 6 5 0 0 0
