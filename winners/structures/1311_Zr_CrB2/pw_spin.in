&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf_spin',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
/
&SYSTEM
  ibrav = 0,
  nat = 5,
  ntyp = 3,
  ecutwfc = 36.0,
  ecutrho = 288.0,
  nspin = 2,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.020,
  starting_magnetization(1) = 0.020,
  starting_magnetization(2) = 0.350,
  starting_magnetization(3) = 0.020,
/
&ELECTRONS
  conv_thr = 1.0d-5,
  mixing_beta = 0.30,
  electron_maxstep = 150,
/
ATOMIC_SPECIES
  B       10.8100  b_pbe_v1.4.uspp.F.UPF
  Cr      51.9961  cr_pbe_v1.5.uspp.F.UPF
  Zr      91.2240  Zr_pbe_v1.uspp.F.UPF
CELL_PARAMETERS {angstrom}
     -3.3990185319      0.0000000000      0.0000000000
     -0.0000000000     -3.3990185319      0.0000000000
      1.6995092659      1.6995092659      4.7771674711
ATOMIC_POSITIONS {crystal}
  Zr       0.0000000000      0.0000000000      0.0000000000
  Cr       0.2500000000      0.7500000000      0.5000000000
  Cr       0.7500000000      0.2500000000      0.5000000000
  B        0.4042393026      0.4042393026      0.8084786051
  B        0.5957606974      0.5957606974      0.1915213949
K_POINTS {automatic}
  6 6 4 0 0 0
