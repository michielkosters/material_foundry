&CONTROL
  calculation = 'vc-relax',
  prefix = 'Zr(CrB)2_1311',
  pseudo_dir = './pseudo/',
  outdir = './out/',
  etot_conv_thr = 1.0d-5,
  forc_conv_thr = 1.0d-4,
/
&SYSTEM
  ibrav = 0,
  nat = 5,
  ntyp = 3,
  ecutwfc = 60.0,
  ecutrho = 480.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.015,
  nspin = 2,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_beta = 0.4,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
/
ATOMIC_SPECIES
  B  10.8100  B.UPF
  Cr  51.9961  Cr.UPF
  Zr  91.2240  Zr.UPF
CELL_PARAMETERS (angstrom)
      3.222765     -0.000000     -1.080330
     -0.362146      3.202353     -1.080330
      0.000195      0.000218      5.347709
ATOMIC_POSITIONS (crystal)
  Zr      0.000000      0.000000      0.000000
  Cr      0.250000      0.750000      0.500000
  Cr      0.750000      0.250000      0.500000
  B      0.404239      0.404239      0.808479
  B      0.595761      0.595761      0.191521
K_POINTS {automatic}
  6 6 6 0 0 0
