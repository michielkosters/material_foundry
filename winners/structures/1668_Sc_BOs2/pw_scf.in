&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
/
&SYSTEM
  ibrav = 0,
  nat = 5,
  ntyp = 3,
  ecutwfc = 40.0,
  ecutrho = 320.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.020,
/
&ELECTRONS
  conv_thr = 1.0d-5,
  mixing_beta = 0.35,
  electron_maxstep = 150,
/
ATOMIC_SPECIES
  B       10.8100  b_pbe_v1.4.uspp.F.UPF
  Os     190.2300  Os_pbe_v1.2.uspp.F.UPF
  Sc      44.9559  Sc_ONCV_PBE-1.0.oncvpsp.upf
CELL_PARAMETERS {angstrom}
     -3.7411208000      0.0000000000      0.0000000000
     -0.0000000000     -3.7411208000      0.0000000000
      1.8705604000      1.8705604000      4.4468415774
ATOMIC_POSITIONS {crystal}
  Sc       0.0000000000      0.0000000000      0.0000000000
  B        0.3972675500      0.3972675500      0.7945351000
  B        0.6027324500      0.6027324500      0.2054649000
  Os       0.2500000000      0.7500000000      0.5000000000
  Os       0.7500000000      0.2500000000      0.5000000000
K_POINTS {automatic}
  6 6 5 0 0 0
