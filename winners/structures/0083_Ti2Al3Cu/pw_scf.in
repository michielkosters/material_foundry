&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 3,
  ecutwfc = 40.0,
  ecutrho = 320.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.020,
/
&ELECTRONS
  conv_thr = 1.0d-5,
  mixing_beta = 0.35,
  electron_maxstep = 150,
/
