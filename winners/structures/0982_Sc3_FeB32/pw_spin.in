  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf_spin',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
