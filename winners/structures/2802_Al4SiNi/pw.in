&CONTROL
  calculation = 'vc-relax',
  prefix = 'Al4SiNi_2802',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out/',
  tprnfor = .true.,
  tstress = .true.,
  etot_conv_thr = 1.0d-5,
  forc_conv_thr = 1.0d-4,
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 3,
  ecutwfc = 60.0,
  ecutrho = 480.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.015,
  nspin = 2,
  starting_magnetization(2) = 0.25,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_beta = 0.4,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
/
ATOMIC_SPECIES
  Al  26.9815  Al.UPF
  Ni  58.6934  Ni.UPF
  Si  28.0850  Si.UPF
