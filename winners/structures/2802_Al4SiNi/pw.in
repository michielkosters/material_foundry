  Al      0.384407      0.384407      0.846779
  Al      0.615593      0.615593      0.153221
  Al      0.133696      0.133696      0.598912
  Si     -0.000000     -0.000000     -0.000000
  Ni      0.500000      0.500000      0.500000
K_POINTS {automatic}
