&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  pseudo_dir = './pseudos/sssp_efficiency',
  outdir = './out',
  prefix = 'pwscf_spin',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'low',
  disk_io = 'none',
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 3,
  ecutwfc = 36.0,
  ecutrho = 288.0,
  nspin = 2,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.020,
  starting_magnetization(1) = 0.020,
  starting_magnetization(2) = 0.200,
  starting_magnetization(3) = 0.020,
/
&ELECTRONS
  conv_thr = 1.0d-5,
  mixing_beta = 0.30,
  electron_maxstep = 150,
/
